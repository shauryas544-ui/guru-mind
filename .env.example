# =============================================================================
# Guru Mind — Environment Configuration Template
# Single root `.env` file configures BOTH backend and frontend (via Vite envDir).
# Copy this file to `.env`:   Copy-Item .env.example .env
# NEVER commit real API keys or service-role secrets to version control.
# =============================================================================

# --- Server / Express API Backend ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- 1. Google Gemini AI Key (Server-side only — Tutor, Mentor, Inner Council, Practice) ---
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- 2. Gnani AI / Vachana Key (Server-side only — Indian Speech-to-Text & TTS Voice) ---
# Get your key from: https://vachana.ai
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani

# --- 3. Supabase (Auth + PostgreSQL Database + RLS) ---
# Find these in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Reliability & Orchestration ---
AI_TIMEOUT_MS=12000
ENABLE_SKEPTIC_SECOND_PASS=false

# --- 4. Frontend Public Variables (Loaded automatically by Vite from root .env) ---
# Paste the SAME Supabase URL & Anon Key here (NEVER put Gemini, Gnani, or Service-Role keys here!)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=/api
